<mxfile host="app.diagrams.net" type="device"><diagram id="p0" name="1 What we build"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="QuickCart - a tiny shop, built as microservices" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Comic Sans MS;fontStyle=1;fontSize=36;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="60" as="geometry"/></mxCell><mxCell id="c3" value="frontend&lt;br&gt;nginx web page" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="440" height="150" as="geometry"/></mxCell><mxCell id="c4" value="product-service&lt;br&gt;FastAPI - catalog" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#d5e8d4;strokeColor=#82b366;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="580" y="150" width="440" height="150" as="geometry"/></mxCell><mxCell id="c5" value="order-service&lt;br&gt;FastAPI - orders" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#ffe6cc;strokeColor=#d79b00;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1120" y="150" width="440" height="150" as="geometry"/></mxCell><mxCell id="c6" value="asks price" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" y="-30" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="3 images | 3 Deployments | 3 Services | 2 ConfigMaps | 1 Ingress (ALB) | 1 Namespace" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#fff2cc;strokeColor=#d6b656;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="1520" height="110" as="geometry"/></mxCell><mxCell id="c8" value="EXPLAIN&lt;br&gt;A shop everyone understands, so all attention goes&lt;br&gt;to HOW it is built and deployed.&lt;br&gt;Each microservice: own code, own image, own Deployment.&lt;br&gt;Teams can change one part without touching the others." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#fff2cc;strokeColor=#d6b656;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1000" height="300" as="geometry"/></mxCell><mxCell id="c9" value="ASK THE CLASS&lt;br&gt;Why not one big&lt;br&gt;app? What breaks&lt;br&gt;when 5 teams share&lt;br&gt;one codebase?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#f8cecc;strokeColor=#b85450;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1080" y="560" width="480" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="2 Request flow + ALB"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="One URL, three services: path-based routing" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Comic Sans MS;fontStyle=1;fontSize=36;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="60" as="geometry"/></mxCell><mxCell id="c3" value="Browser" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#f5f5f5;strokeColor=#666666;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="240" height="110" as="geometry"/></mxCell><mxCell id="c4" value="AWS ALB&lt;br&gt;one public URL" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#fff2cc;strokeColor=#d6b656;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="380" y="230" width="300" height="170" as="geometry"/></mxCell><mxCell id="c5" value="/  -&gt;  frontend" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="860" y="120" width="460" height="100" as="geometry"/></mxCell><mxCell id="c6" value="/api/products  -&gt;  product" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#d5e8d4;strokeColor=#82b366;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="860" y="265" width="460" height="100" as="geometry"/></mxCell><mxCell id="c7" value="/api/orders  -&gt;  order" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#ffe6cc;strokeColor=#d79b00;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="860" y="410" width="460" height="100" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="255"/><mxPoint x="770" y="170"/></Array></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="375"/><mxPoint x="770" y="460"/></Array></mxGeometry></mxCell><mxCell id="c12" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="460"/><mxPoint x="1440" y="315"/></Array></mxGeometry></mxCell><mxCell id="c13" value="EXPLAIN&lt;br&gt;The ALB reads the PATH of every request and picks the service.&lt;br&gt;The browser never knows there are 3 services.&lt;br&gt;order-service calls product-service INSIDE the cluster&lt;br&gt;using the Service name - that is service-to-service traffic." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#fff2cc;strokeColor=#d6b656;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1000" height="280" as="geometry"/></mxCell><mxCell id="c14" value="ASK THE CLASS&lt;br&gt;How does /api/products&lt;br&gt;reach product-service&lt;br&gt;and not the frontend?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#f8cecc;strokeColor=#b85450;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1080" y="580" width="480" height="280" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="3 Who creates the ALB"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Ingress -&gt; Load Balancer Controller -&gt; ALB" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Comic Sans MS;fontStyle=1;fontSize=36;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="60" as="geometry"/></mxCell><mxCell id="c3" value="Ingress&lt;br&gt;k8s/40-ingress.yaml" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#fff2cc;strokeColor=#d6b656;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="400" height="140" as="geometry"/></mxCell><mxCell id="c4" value="AWS Load Balancer&lt;br&gt;Controller (in cluster)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#e1d5e7;strokeColor=#9673a6;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="580" y="200" width="440" height="140" as="geometry"/></mxCell><mxCell id="c5" value="Real AWS ALB&lt;br&gt;+ rules + health checks" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1160" y="200" width="400" height="140" as="geometry"/></mxCell><mxCell id="c6" value="watches" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" y="-30" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" y="-30" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="IAM role via IRSA&lt;br&gt;(made by eksctl)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#f5f5f5;strokeColor=#666666;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="580" y="400" width="440" height="100" as="geometry"/></mxCell><mxCell id="c9" value="EXPLAIN&lt;br&gt;Kubernetes knows nothing about AWS. The controller does.&lt;br&gt;It watches Ingress objects and calls AWS for us.&lt;br&gt;It gets AWS permissions through an IAM role linked to its&lt;br&gt;service account (IRSA) - no access keys anywhere." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#fff2cc;strokeColor=#d6b656;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1000" height="280" as="geometry"/></mxCell><mxCell id="c10" value="ASK THE CLASS&lt;br&gt;Without the&lt;br&gt;controller, what&lt;br&gt;happens to our&lt;br&gt;Ingress?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#f8cecc;strokeColor=#b85450;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1080" y="580" width="480" height="280" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="4 CI then CD"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="The full loop: CI builds, Git decides, Argo CD deploys" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Comic Sans MS;fontStyle=1;fontSize=36;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="60" as="geometry"/></mxCell><mxCell id="c3" value="git push&lt;br&gt;(code)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#ffe6cc;strokeColor=#d79b00;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="240" height="110" as="geometry"/></mxCell><mxCell id="c4" value="GitHub Actions&lt;br&gt;build 3 images" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#e1d5e7;strokeColor=#9673a6;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="360" y="140" width="300" height="110" as="geometry"/></mxCell><mxCell id="c5" value="Docker Hub&lt;br&gt;:commit-sha" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="740" y="140" width="260" height="110" as="geometry"/></mxCell><mxCell id="c6" value="Git k8s/&lt;br&gt;new image tags" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#d5e8d4;strokeColor=#82b366;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="360" y="340" width="300" height="120" as="geometry"/></mxCell><mxCell id="c7" value="Argo CD&lt;br&gt;syncs" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#e1d5e7;strokeColor=#9673a6;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="740" y="340" width="260" height="120" as="geometry"/></mxCell><mxCell id="c8" value="EKS + ALB&lt;br&gt;live" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1080" y="340" width="260" height="120" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" y="-30" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="commit tags" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="watches" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" y="-30" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" y="-30" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="CI never touches the cluster.&lt;br&gt;The image: line in Git is the handshake." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1080" y="140" width="480" height="110" as="geometry"/></mxCell><mxCell id="c15" value="EXPLAIN&lt;br&gt;Job 1 builds and pushes images tagged with the commit ID.&lt;br&gt;Job 2 writes those tags into k8s/*.yaml and commits.&lt;br&gt;Argo CD sees the commit and deploys.&lt;br&gt;Nobody runs kubectl - ever." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#fff2cc;strokeColor=#d6b656;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="1000" height="300" as="geometry"/></mxCell><mxCell id="c16" value="ASK THE CLASS&lt;br&gt;Where did the Docker&lt;br&gt;Hub password come&lt;br&gt;from? It is not in&lt;br&gt;the workflow file." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#f8cecc;strokeColor=#b85450;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1080" y="560" width="480" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="5 Push vs Pull"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c8" value="GITOPS: PULL" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;fillStyle=solid;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="740" height="400" as="geometry"/></mxCell><mxCell id="c3" value="OLD: PUSH" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;fillStyle=solid;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="740" height="400" as="geometry"/></mxCell><mxCell id="c2" value="Why Argo CD pulls instead of the pipeline pushing" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Comic Sans MS;fontStyle=1;fontSize=36;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="60" as="geometry"/></mxCell><mxCell id="c4" value="CI pipeline&lt;br&gt;(holds&lt;br&gt;prod keys)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#ffffff;strokeColor=#000000;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="280" height="130" as="geometry"/></mxCell><mxCell id="c5" value="Cluster" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#ffffff;strokeColor=#000000;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="560" y="200" width="180" height="130" as="geometry"/></mxCell><mxCell id="c6" value="kubectl&lt;br&gt;apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" y="-30" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="Keys outside. Nobody watches after deploy." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="380" width="660" height="100" as="geometry"/></mxCell><mxCell id="c9" value="Git" style="rounded=1;whiteSpace=wrap;