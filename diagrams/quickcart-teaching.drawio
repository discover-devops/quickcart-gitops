" parent="1"><mxGeometry x="1080" y="570" width="480" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="8 Code vs Config"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c9" value="CONFIG CHANGE" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;fillStyle=solid;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="740" height="400" as="geometry"/></mxCell><mxCell id="c3" value="CODE CHANGE" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;fillStyle=solid;verticalAlign=top;align=left;spacingLeft=16;spacingTop=6;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="740" height="400" as="geometry"/></mxCell><mxCell id="c2" value="Two kinds of change, two different paths" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Comic Sans MS;fontStyle=1;fontSize=36;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="60" as="geometry"/></mxCell><mxCell id="c4" value="edit app/product-service/main.py" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#ffffff;strokeColor=#000000;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="80" y="180" width="660" height="80" as="geometry"/></mxCell><mxCell id="c5" value="CI builds new image" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#ffffff;strokeColor=#00000