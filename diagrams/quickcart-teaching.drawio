figMap" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#ffffff;strokeColor=#000000;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="860" y="400" width="660" height="80" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="EXPLAIN&lt;br&gt;Prices, banners and flags are configuration, not code.&lt;br&gt;The pipeline only runs when app/ changes.&lt;br&gt;The mounted ConfigMap file refreshes in about a minute,&lt;br&gt;so the new price is live with no restart." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#fff2cc;strokeColor=#d6b656;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1000" height="290" as="geometry"/></mxCell><mxCell id="c16" value="ASK THE CLASS&lt;br&gt;Will the pipeline&lt;br&gt;run when I change&lt;br&gt;a price?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#f8cecc;strokeColor=#b85450;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1080" y="570" width="480" height="290" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="9 Rollback"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Rollback = git revert the release commit" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Comic Sans MS;fontStyle=1;fontSize=36;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="60" as="geometry"/></mxCell><mxCell id="c3" value="v1.1.0 has a bug" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#f8cecc;strokeColor=#b85450;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="340" height="120" as="geometry"/></mxCell><mxCell id="c4" value="git revert&lt;br&gt;release commit" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#ffe6cc;strokeColor=#d79b00;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="460" y="180" width="340" height="120" as="geometry"/></mxCell><mxCell id="c5" value="Git points at&lt;br&gt;old image" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#d5e8d4;strokeColor=#82b366;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="880" y="180" width="300" height="120" as="geometry"/></mxCell><mxCell id="c6" value="Argo CD&lt;br&gt;deploys v1.0.0" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1260" y="180" width="300" height="120" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="EXPLAIN&lt;br&gt;The old image is still on Docker Hub - no rebuild needed.&lt;br&gt;The bot&#x27;s &#x27;ci: release images&#x27; commit IS the deployment.&lt;br&gt;Revert it and you revert the deployment.&lt;br&gt;History keeps both the release and the rollback." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#fff2cc;strokeColor=#d6b656;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1000" height="300" as="geometry"/></mxCell><mxCell id="c11" value="ASK THE CLASS&lt;br&gt;Do we need to&lt;br&gt;rebuild the old&lt;br&gt;version to&lt;br&gt;roll back?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#f8cecc;strokeColor=#b85450;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1080" y="420" width="480" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p9" name="10 Clean up order"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Clean up in the right order: ALB first" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Comic Sans MS;fontStyle=1;fontSize=36;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="60" as="geometry"/></mxCell><mxCell id="c3" value="1. delete&lt;br&gt;Argo CD app" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#e1d5e7;strokeColor=#9673a6;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="340" height="120" as="geometry"/></mxCell><mxCell id="c4" value="2. wait: ALB&lt;br&gt;gone" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#fff2cc;strokeColor=#d6b656;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="460" y="180" width="340" height="120" as="geometry"/></mxCell><mxCell id="c5" value="3. helm&lt;br&gt;uninstall" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#f5f5f5;strokeColor=#666666;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="880" y="180" width="300" height="120" as="geometry"/></mxCell><mxCell id="c6" value="4. eksctl&lt;br&gt;delete" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#f8cecc;strokeColor=#b85450;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1260" y="180" width="300" height="120" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;strokeColor=#000000;fontColor=#000000;endArrow=classic;endFill=1;endSize=10;labelBackgroundColor=#ffffff;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="EXPLAIN&lt;br&gt;The ALB was made by the controller, not by eksctl.&lt;br&gt;Delete the cluster first and the ALB is orphaned:&lt;br&gt;it keeps costing money and blocks the VPC deletion.&lt;br&gt;The app&#x27;s finalizer removes the Ingress, then the ALB." style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#fff2cc;strokeColor=#d6b656;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1000" height="300" as="geometry"/></mxCell><mxCell id="c11" value="ASK THE CLASS&lt;br&gt;What happens if&lt;br&gt;we run eksctl&lt;br&gt;delete first?" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;strokeWidth=4;fillColor=#f8cecc;strokeColor=#b85450;fillStyle=solid;fontFamily=Comic Sans MS;fontStyle=1;fontSize=25;" vertex="1" parent="1"><mxGeometry x="1080" y="420" width="480" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>